{
  "name": "@kvcomm/openclaw-bench-driver",
  "private": true,
  "type": "module",
  "description": "OpenClaw subagent stack + TTFT benchmark (implementation; use ../openclaw/cli.mjs)",
  "scripts": {
    "run": "node ../openclaw/cli.mjs bench run",
    "dry-run": "node ../openclaw/cli.mjs bench run --dry-run --task-id micro-001",
    "verify-dataset": "node ../openclaw/cli.mjs bench run --dry-run --task-id micro-001 --agent-count 3"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=20"
  }
}
