{
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "model": {
        "primary": "kvcomm/Qwen3-32B"
      },
      "compaction": {
        "reserveTokensFloor": 0,
        "reserveTokens": 256
      },
      "timeoutSeconds": 600,
      "models": {
        "kvcomm/Qwen3-32B": {
          "params": {
            "extra_body": {
              "kvcomm": {}
            }
          }
        }
      }
    },
    "list": [
      {
        "id": "main",
        "tools": {
          "profile": "coding",
          "alsoAllow": ["sessions_spawn"]
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "CHANGE_ME_AFTER_SETUP"
    },
    "port": 18789,
    "bind": "loopback",
    "controlUi": {
      "allowInsecureAuth": true
    },
    "tools": {
      "allow": ["sessions_spawn"]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "webchat": ["*"]
      }
    },
    "subagents": {
      "tools": {
        "allow": ["read", "write", "edit", "apply_patch", "exec", "process", "session_status"]
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "kvcomm": {
        "baseUrl": "http://127.0.0.1:8100/v1",
        "apiKey": "kvcomm-local",
        "api": "openai-completions",
        "timeoutSeconds": 600,
        "models": [
          {
            "id": "Qwen3-32B",
            "name": "Qwen3 32B (KVCOMM sidecar)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 32768,
            "contextTokens": 32768,
            "maxTokens": 4096
          }
        ]
      }
    }
  }
}
